using AgriPurchaseBilling.Application.DTOs;
using AgriPurchaseBilling.Application.Exceptions;
using AgriPurchaseBilling.Application.Interfaces;
using AgriPurchaseBilling.Domain.Entities;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Mvc;
using System.Security.Claims;

namespace Backend.AgriPurchaseBilling.Api.Controllers
{
    /// <summary>
    /// Customer My Profile Controller providing end-to-end management of customer account
    /// profile information and saved delivery addresses.
    /// </summary>
    [ApiController]
    [Authorize(Roles = "Customer")]
    [Route("api/customer/profile")]
    [Produces("application/json")]
    public class CustomerProfileController : ControllerBase
    {
        private readonly ICustomerProfileService _profileService;
        private readonly ILogger<CustomerProfileController> _logger;

        public CustomerProfileController(ICustomerProfileService profileService, ILogger<CustomerProfileController> logger)
        {
            _profileService = profileService;
            _logger = logger;
        }

        private (long? CustomerId, bool IsForbidden) GetCurrentCustomerId()
        {
            var roleClaim = User.FindFirst(ClaimTypes.Role)?.Value
                         ?? User.FindFirst("role")?.Value;

            // If role is present, ensure caller has Customer role
            if (!string.IsNullOrEmpty(roleClaim) &&
                !string.Equals(roleClaim, "Customer", StringComparison.OrdinalIgnoreCase))
            {
                return (null, true);
            }

            var claimValue = User.FindFirstValue(ClaimTypes.NameIdentifier)
                          ?? User.FindFirstValue("sub")
                          ?? User.FindFirstValue("id");

            if (long.TryParse(claimValue, out var id) && id > 0)
            {
                return (id, false);
            }

            return (null, false);
        }

        /// <summary>
        /// API 1: Get Customer Profile (including profile details and saved delivery addresses)
        /// GET /api/customer/profile
        /// </summary>
        [HttpGet]
        [ProducesResponseType(typeof(ApiResponse<CustomerProfileDto>), StatusCodes.Status200OK)]
        [ProducesResponseType(typeof(ApiResponse<object>), StatusCodes.Status401Unauthorized)]
        [ProducesResponseType(typeof(ApiResponse<object>), StatusCodes.Status403Forbidden)]
        [ProducesResponseType(typeof(ApiResponse<object>), StatusCodes.Status404NotFound)]
        public async Task<ActionResult<ApiResponse<CustomerProfileDto>>> GetProfile(CancellationToken cancellationToken)
        {
            var (customerId, isForbidden) = GetCurrentCustomerId();
            if (isForbidden)
            {
                return StatusCode(StatusCodes.Status403Forbidden, ApiResponse<CustomerProfileDto>.ErrorResponse("Forbidden: Only customers can access this resource."));
            }

            if (!customerId.HasValue)
            {
                return Unauthorized(ApiResponse<CustomerProfileDto>.ErrorResponse("Authentication required. Please log in."));
            }

            _logger.LogInformation("GET /api/customer/profile for CustomerId: {CustomerId}", customerId.Value);
            var result = await _profileService.GetProfileAsync(customerId.Value, cancellationToken);

            if (result == null)
            {
                return NotFound(ApiResponse<CustomerProfileDto>.ErrorResponse("Customer profile not found."));
            }

            return Ok(ApiResponse<CustomerProfileDto>.SuccessResponse(result, "Customer profile retrieved successfully."));
        }

        /// <summary>
        /// API 2: Update Customer Profile
        /// PUT /api/customer/profile
        /// </summary>
        [HttpPut]
        [ProducesResponseType(typeof(ApiResponse<CustomerProfileDto>), StatusCodes.Status200OK)]
        [ProducesResponseType(typeof(ApiResponse<object>), StatusCodes.Status400BadRequest)]
        [ProducesResponseType(typeof(ApiResponse<object>), StatusCodes.Status401Unauthorized)]
        [ProducesResponseType(typeof(ApiResponse<object>), StatusCodes.Status403Forbidden)]
        public async Task<ActionResult<ApiResponse<CustomerProfileDto>>> UpdateProfile(
            [FromBody] UpdateCustomerProfileDto request,
            CancellationToken cancellationToken = default)
        {
            var (customerId, isForbidden) = GetCurrentCustomerId();
            if (isForbidden)
            {
                return StatusCode(StatusCodes.Status403Forbidden, ApiResponse<CustomerProfileDto>.ErrorResponse("Forbidden: Only customers can access this resource."));
            }

            if (!customerId.HasValue)
            {
                return Unauthorized(ApiResponse<CustomerProfileDto>.ErrorResponse("Authentication required. Please log in."));
            }

            if (!ModelState.IsValid)
            {
                var errors = ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).ToList();
                return BadRequest(ApiResponse<CustomerProfileDto>.ErrorResponse("Validation failed.", errors));
            }

            try
            {
                _logger.LogInformation("PUT /api/customer/profile for CustomerId: {CustomerId}", customerId.Value);
                var result = await _profileService.UpdateProfileAsync(customerId.Value, request, cancellationToken);

                if (result == null)
                {
                    return NotFound(ApiResponse<CustomerProfileDto>.ErrorResponse("Customer profile not found."));
                }

                return Ok(ApiResponse<CustomerProfileDto>.SuccessResponse(result, "Customer profile updated successfully."));
            }
            catch (ArgumentException ex)
            {
                return BadRequest(ApiResponse<CustomerProfileDto>.ErrorResponse(ex.Message));
            }
            catch (InvalidOperationException ex)
            {
                return Conflict(ApiResponse<CustomerProfileDto>.ErrorResponse(ex.Message));
            }
        }

        /// <summary>
