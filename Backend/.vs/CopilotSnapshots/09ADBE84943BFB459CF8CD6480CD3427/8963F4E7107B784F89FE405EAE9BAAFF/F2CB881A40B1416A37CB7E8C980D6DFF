        [ProducesResponseType(typeof(ApiResponse<object>), StatusCodes.Status401Unauthorized)]
        [ProducesResponseType(typeof(ApiResponse<object>), StatusCodes.Status403Forbidden)]
        [ProducesResponseType(typeof(ApiResponse<object>), StatusCodes.Status409Conflict)]
        public async Task<ActionResult<ApiResponse<MobileChangeOtpResponseDto>>> SendMobileChangeOtp(
            [FromBody] SendMobileChangeOtpDto request,
            CancellationToken cancellationToken = default)
        {
            var (customerId, isForbidden) = GetCurrentCustomerId();
            if (isForbidden)
            {
                return StatusCode(StatusCodes.Status403Forbidden, ApiResponse<MobileChangeOtpResponseDto>.ErrorResponse("Forbidden: Only customers can access this resource."));
            }

            if (!customerId.HasValue)
            {
                return Unauthorized(ApiResponse<MobileChangeOtpResponseDto>.ErrorResponse("Authentication required. Please log in."));
            }

            if (!ModelState.IsValid)
            {
                var errors = ModelState.Values.SelectMany(v => v.Errors).Select(e => e.ErrorMessage).ToList();
                return BadRequest(ApiResponse<MobileChangeOtpResponseDto>.ErrorResponse("Validation failed.", errors));
            }

            try
            {
                _logger.LogInformation("POST /api/customer/profile/mobile/send-otp for CustomerId: {CustomerId}", customerId.Value);
                var result = await _profileService.SendMobileChangeOtpAsync(customerId.Value, request, cancellationToken);
                return Ok(ApiResponse<MobileChangeOtpResponseDto>.SuccessResponse(result, result.Message));
            }
            catch (SmsDeliveryException ex)
            {
                return StatusCode(StatusCodes.Status503ServiceUnavailable,
                    ApiResponse<MobileChangeOtpResponseDto>.ErrorResponse(ex.Message));
            }
            catch (ArgumentException ex)
            {
                return BadRequest(ApiResponse<MobileChangeOtpResponseDto>.ErrorResponse(ex.Message));
            }
            catch (InvalidOperationException ex)
            {
                return Conflict(ApiResponse<MobileChangeOtpResponseDto>.ErrorResponse(ex.Message));
            }
        }

