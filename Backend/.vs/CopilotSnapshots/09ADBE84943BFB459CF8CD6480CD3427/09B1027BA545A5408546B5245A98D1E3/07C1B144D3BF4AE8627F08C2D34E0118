-- Vendor My Profile tables. Existing user, vendor, and role tables are not altered.

CREATE TABLE IF NOT EXISTS `vendor_profiles` (
  `id` BIGINT NOT NULL AUTO_INCREMENT,
  `vendor_id` BIGINT NULL,
  `vendor_code` VARCHAR(30) NOT NULL,
  `business_name` VARCHAR(200) NOT NULL,
  `owner_name` VARCHAR(100) NOT NULL,
  `mobile` VARCHAR(10) NOT NULL,
  `email` VARCHAR(150) NOT NULL DEFAULT '',
  `gstin` VARCHAR(15) NOT NULL DEFAULT '',
  `business_reg_number` VARCHAR(50) NOT NULL DEFAULT '',
  `apmc_license_number` VARCHAR(50) NULL,
  `business_type` VARCHAR(100) NOT NULL DEFAULT '',
  `business_address` VARCHAR(500) NOT NULL DEFAULT '',
  `district` VARCHAR(100) NOT NULL DEFAULT '',
  `state` VARCHAR(100) NOT NULL DEFAULT '',
  `pin_code` VARCHAR(6) NOT NULL DEFAULT '',
  `is_active` TINYINT(1) NOT NULL DEFAULT 1,
  `is_verified` TINYINT(1) NOT NULL DEFAULT 0,
  `otp_security_enabled` TINYINT(1) NOT NULL DEFAULT 1,
  `gst_billing_enabled` TINYINT(1) NOT NULL DEFAULT 1,
  `compliance_updated_at` DATETIME(6) NULL,
  `created_at` DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),
  `updated_at` DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6) ON UPDATE CURRENT_TIMESTAMP(6),
  PRIMARY KEY (`id`),
  UNIQUE KEY `UX_vendor_profiles_code` (`vendor_code`),
  UNIQUE KEY `UX_vendor_profiles_vendor_id` (`vendor_id`),
  CONSTRAINT `FK_vendor_profiles_Vendors` FOREIGN KEY (`vendor_id`) REFERENCES `Vendors` (`Id`) ON DELETE SET NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

CREATE TABLE IF NOT EXISTS `vendor_bank_accounts` (
  `id` BIGINT NOT NULL AUTO_INCREMENT,
  `vendor_profile_id` BIGINT NOT NULL,
  `account_holder_name` VARCHAR(200) NOT NULL,
  `bank_name` VARCHAR(150) NOT NULL,
  `branch_name` VARCHAR(150) NOT NULL,
  `account_number` VARCHAR(20) NOT NULL,
  `ifsc_code` VARCHAR(11) NOT NULL,
  `is_primary` TINYINT(1) NOT NULL DEFAULT 1,
  `created_at` DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6),
  `updated_at` DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6) ON UPDATE CURRENT_TIMESTAMP(6),
  PRIMARY KEY (`id`),
  UNIQUE KEY `UX_vendor_bank_accounts_profile` (`vendor_profile_id`),
  CONSTRAINT `FK_vendor_bank_accounts_profile` FOREIGN KEY (`vendor_profile_id`) REFERENCES `vendor_profiles` (`id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
